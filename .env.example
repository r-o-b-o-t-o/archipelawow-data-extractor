# Where quests.json is written. Point this at ArchipelaWoW's data/locations directory.
OUT_DIR=../archipelawow/data/locations

# AzerothCore world database. Read-only; nothing is ever written to it.
WORLD_DB_HOST=localhost
WORLD_DB_PORT=3306
WORLD_DB_USER=acore
WORLD_DB_PASSWORD=acore
WORLD_DB_DATABASE=acore_world

# Directory holding the extracted client DBC files, e.g. AzerothCore's data/dbc.
DBC_DIRECTORY=/path/to/azerothcore/data/dbc
DBC_LOCALE=enUS
DBC_BUILD=3.3.5.12340
